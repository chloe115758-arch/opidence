# 이 파일을 .env.local로 복사한 뒤 값을 채운다. .env.local은 커밋하지 않는다.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# publishable 키(sb_publishable_…). 없으면 anon 키를 넣는다. secret·service_role 키는 넣지 않는다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# OpenAI: 서버에서만 쓴다. 이름에 NEXT_PUBLIC_을 붙이지 않는다.
OPENAI_API_KEY=
OPENAI_MODEL=
# 차원이 다른 모델로 바꾸면 DB 벡터 열과 임베딩을 다시 만들어야 한다.
OPENAI_EMBEDDING_MODEL=

# 개발 전용: 1이면 OpenAI를 부르지 않고 "근거 없음" 경로를 강제하는 가짜 응답을 쓴다. production에서는 무시된다.
# MOCK_AI=1
